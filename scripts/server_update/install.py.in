"""Install the execution-idle updater used by the existing image-event consumer.

Default: check target and candidate only. --apply pauses the consumer, atomically
switches its existing updater launcher, updates the server, then resumes a previously
active consumer. Queue history, webhook and tunnel configuration are preserved.
Requires maintenance support already running in the server (first rollout is manual).
Rejects removed database columns; no backup/restore or broad compatibility gates.
Do not deploy concurrently.
"""

from __future__ import annotations

import argparse
import base64
import fcntl
import hashlib
import io
import os
import platform
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
from contextlib import ExitStack, closing
from pathlib import Path

BUNDLE_SHA256 = "__BUNDLE_SHA256__"
BUNDLE_BASE64 = "__BUNDLE_BASE64__"
SERVICE = "agentflow-image-deploy.service"


def extract(directory: Path) -> None:
    """Extract only the regular, bounded members of the pinned bundle."""
    payload = base64.b64decode(BUNDLE_BASE64, validate=True)
    if hashlib.sha256(payload).hexdigest() != BUNDLE_SHA256:
        raise RuntimeError("Embedded bundle checksum mismatch")
    expected = {"update-agentflow-server.py", "agentflow-maintenance.py", "column-check.py"}
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        members = archive.getmembers()
        if len(members) != len(expected) or {member.name for member in members} != expected:
            raise RuntimeError("Unexpected bundle members")
        for member in members:
            if not member.isfile() or member.size > 128 * 1024:
                raise RuntimeError("Unsafe bundle member")
            stream = archive.extractfile(member)
            if stream is None:
                raise RuntimeError("Missing bundle member")
            with stream:
                data = stream.read()
            compile(data, member.name, "exec")
            with (directory / member.name).open("xb") as output:
                output.write(data)


def target(home: Path) -> tuple[list[str], dict[Path, str]]:
    """Reuse the existing interpreter and five pinned target fields, never arbitrary shell."""
    library = home / ".local/lib/agentflow-server-update"
    launcher = home / ".local/bin/agentflow-server-update"
    if not launcher.is_file() or launcher.is_symlink():
        raise RuntimeError("Missing or symlinked installed launcher")
    lines = launcher.read_text().splitlines()
    if len(lines) != 2 or not lines[1].startswith("exec "):
        raise RuntimeError("Unrecognized installed launcher")
    arguments = shlex.split(lines[1])
    if (
        len(arguments) != 14
        or arguments[0] != "exec"
        or arguments[-1] != "$@"
        or not Path(arguments[1]).is_absolute()
        or not Path(arguments[1]).is_file()
    ):
        raise RuntimeError("Unexpected launcher interpreter or command")
    live = Path(arguments[2])
    if (
        not live.is_absolute()
        or not live.resolve().is_relative_to(library.resolve())
        or live.name != "update-agentflow-server.py"
    ):
        raise RuntimeError("Unexpected installed updater location")
    installed = [launcher, live, live.with_name("agentflow-maintenance.py")]
    # Fingerprint optional checkers too, preserving old releases and concurrent writers' changes.
    for name in ("schema-compatibility.py", "wire_compatibility.py", "column-check.py"):
        checker = live.with_name(name)
        if checker.exists():
            installed.append(checker)
    for path in installed:
        if not path.is_file() or path.is_symlink():
            raise RuntimeError(f"Missing or symlinked installed file: {path}")
    before = {path: hashlib.sha256(path.read_bytes()).hexdigest() for path in installed}
    fields = dict(zip(arguments[3:13:2], arguments[4:13:2], strict=True))
    if set(fields) != {"--context", "--namespace", "--workload", "--container", "--node"}:
        raise RuntimeError("Unexpected pinned target arguments")
    if any(not value.strip() for value in fields.values()):
        raise RuntimeError("Pinned target contains an empty value")
    return [arguments[1], *arguments[3:13]], before


def install(home: Path, directory: Path, pinned: list[str], before: dict[Path, str]) -> Path:
    """Keep existing sources intact; atomically switch only the pinned launcher."""
    for path, digest in before.items():
        if path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
            raise RuntimeError(f"Installed tool changed concurrently: {path}")
    library = home / ".local/lib/agentflow-server-update"
    version = library / "releases" / BUNDLE_SHA256[:20]
    version.mkdir(parents=True, mode=0o700, exist_ok=True)
    for source in sorted(directory.glob("*.py")):
        destination = version / source.name
        if destination.exists():
            if destination.is_symlink() or destination.read_bytes() != source.read_bytes():
                raise RuntimeError("Existing updater version has different contents")
        else:
            with destination.open("xb") as stream:
                stream.write(source.read_bytes())
                stream.flush()
                os.fsync(stream.fileno())
    for path in (version, version.parent):
        descriptor = os.open(path, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    launcher = home / ".local/bin/agentflow-server-update"
    (directory / "launcher.before").write_bytes(launcher.read_bytes())
    command = [pinned[0], str(version / "update-agentflow-server.py"), *pinned[1:]]
    content = "#!/bin/sh\nexec " + shlex.join(command) + ' "$@"\n'
    descriptor, name = tempfile.mkstemp(prefix=".agentflow-server-update-", dir=launcher.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(0o700)
        temporary.replace(launcher)
        descriptor = os.open(launcher.parent, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        temporary.unlink(missing_ok=True)
    return launcher


def service_state() -> str:
    return subprocess.check_output(
        ["systemctl", "show", "--property=ActiveState", "--value", SERVICE],
        text=True,
        timeout=30,
    ).strip()


def main() -> int:
    """Check, install, and update; retain evidence and the paused consumer after failure."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="install and perform the upgrade")
    parser.add_argument("--image", required=True, help="immutable ghcr.io image reference")
    args = parser.parse_args()
    if platform.system() != "Linux" or os.geteuid() == 0:
        parser.error("Run as the existing installing user on the deployment host, without sudo")
    for executable in ("kubectl", "systemctl", "sudo"):
        if shutil.which(executable) is None:
            parser.error(f"Missing command: {executable}")
    os.umask(0o077)
    home = Path.home()
    root = home / ".local/state/agentflow-updater-install"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="install-", dir=root))
    stage, paused = "prepare", False
    print(f"Working files: {directory}", flush=True)
    try:
        with ExitStack() as stack:
            lock_path = root / "upgrade.lock"
            if lock_path.is_symlink():
                raise RuntimeError("Symlinked upgrade lock rejected")
            lock = stack.enter_context(lock_path.open("a"))
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            pinned, before = target(home)
            extract(directory)
            command = [
                pinned[0],
                str(directory / "update-agentflow-server.py"),
                *pinned[1:],
                "--image",
                args.image,
            ]
            stage = "check-image-and-target"
            print(f"Stage: {stage}", flush=True)
            subprocess.run(command, check=True)
            if not args.apply:
                print("CHECK ONLY: no installation or upgrade performed; rerun with --apply.")
                return 0

            stage = "pause-consumer"
            subprocess.run(["sudo", "-v"], check=True)
            prior_state = service_state()
            if prior_state not in {"active", "inactive", "failed"}:
                raise RuntimeError(f"Consumer state is transitional: {prior_state}")
            consumer = home / ".local/state/agentflow-image-deploy"
            queue = consumer / "queue.sqlite3"
            if not queue.is_file() or queue.is_symlink():
                raise RuntimeError("Missing or symlinked existing queue")
            with closing(sqlite3.connect(queue.as_uri() + "?mode=rw", uri=True, timeout=10)) as db:
                db.execute("BEGIN IMMEDIATE")
                if db.execute("SELECT 1 FROM events WHERE state='running' LIMIT 1").fetchone():
                    raise RuntimeError("A deployment event is running; consumer left untouched")
                subprocess.run(["sudo", "systemctl", "stop", SERVICE], check=True, timeout=60)
                paused = True
                if service_state() not in {"inactive", "failed"}:
                    raise RuntimeError("Consumer did not stop")
                db.commit()
            consumer_lock = consumer / "consumer.lock"
            if consumer_lock.is_symlink():
                raise RuntimeError("Symlinked consumer lock rejected")
            stream = stack.enter_context(consumer_lock.open("a"))
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)

            stage = "install-execution-idle-updater"
            print(f"Stage: {stage}", flush=True)
            launcher = install(home, directory, pinned, before)
            installed_target, installed_hashes = target(home)
            if installed_target != pinned:
                raise RuntimeError("Installed target changed during installation")
            stage = "apply-update"
            print(f"Stage: {stage}", flush=True)
            subprocess.run([str(launcher), "--image", args.image, "--apply"], check=True)
            preserved = {path: digest for path, digest in before.items() if path != launcher}
            for path, digest in (preserved | installed_hashes).items():
                if path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
                    raise RuntimeError(f"Installed tool changed concurrently: {path}")
            fcntl.flock(stream, fcntl.LOCK_UN)
            if prior_state == "active":
                stage = "resume-consumer"
                subprocess.run(["sudo", "systemctl", "start", SERVICE], check=True, timeout=60)
                if service_state() != "active":
                    raise RuntimeError("Consumer did not become active")
            print("DONE: execution-idle updater installed; server ready; admissions resumed.")
            print(
                "Future events reject removed columns; backup/restore and broad compatibility gates remain disabled."
            )
            print("Worker drain flags, old sources, queue history, webhook and tunnel preserved.")
            print(f"Consumer state: {service_state()}; previously: {prior_state}")
            return 0
    except (
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        sqlite3.Error,
        subprocess.SubprocessError,
        tarfile.TarError,
        KeyboardInterrupt,
    ) as error:
        print(f"STOPPED: stage={stage}; {error}", file=sys.stderr, flush=True)
        print(f"Working files retained: {directory}", file=sys.stderr)
        if paused:
            print(
                "Consumer was paused. Inspect operation.json before restarting or retrying.",
                file=sys.stderr,
            )
        print(
            "No rollback, failure resume, database restore or queue reset attempted.",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

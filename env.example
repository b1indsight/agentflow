# ---- GitHub App（docs/architecture/github-app.md）----
AGENTFLOW_GITHUB_APP_ID=123456
AGENTFLOW_GITHUB_PRIVATE_KEY_PATH=./agentflow-app.private-key.pem
AGENTFLOW_GITHUB_WEBHOOK_SECRET=change-me
# serve 端 GitHub 网络各阶段超时（秒，正有限值；不是整个恢复任务的总时限）
AGENTFLOW_GITHUB_REQUEST_TIMEOUT_SECONDS=30
# bot 身份（用于忽略自身事件，见 docs/architecture/review-loop.md §B.1）
AGENTFLOW_BOT_LOGIN=agentflow[bot]

# ---- 触发 ----
AGENTFLOW_TRIGGER_LABEL=flow
# 允许触发的用户，逗号分隔（见 docs/architecture/components.md §4.2）
AGENTFLOW_ALLOWLIST=your-username
# PR reviewer 与触发者权限独立；空值表示不请求 reviewer
AGENTFLOW_REVIEWERS=your-reviewer
AGENTFLOW_IN_REVIEW_LABEL=flow:in-review
# 预先在仓库创建两个状态标签；trigger/in-review/done 名称须互不相同（忽略大小写）
AGENTFLOW_DONE_LABEL=flow:done

# ---- PostgreSQL（compose.yaml 的本地开发凭据；远程部署必须使用 TLS 和独立密码）----
AGENTFLOW_DATABASE_URL=postgresql://agentflow:agentflow@127.0.0.1:5432/agentflow

# ---- serve 允许的 worker 身份（JSON；id 与 token 均须唯一且非空）----
AGENTFLOW_WORKER_TOKENS={"worker-1":"change-me-worker-token","worker-2":"change-me-worker-token-2"}

# ---- 修订循环参数（docs/architecture/review-loop.md §B.6）----
AGENTFLOW_SETTLE_SECONDS=75
AGENTFLOW_SUBMIT_GRACE_SECONDS=15
AGENTFLOW_CONFIDENCE_THRESHOLD=0.6
AGENTFLOW_MAX_REVISION_CYCLES=20

# ---- HTTP ----
# 只配置在 control；三项均留空禁用用户 API。开启前完成 Cloudflare Access 策略和 MFA。
# 详见 docs/deployment/access.md；不保存 OAuth secret 或 Cloudflare 管理 token。
AGENTFLOW_ACCESS_ISSUER=
AGENTFLOW_ACCESS_AUDIENCE=
AGENTFLOW_ACCESS_OWNER_EMAIL=
AGENTFLOW_HOST=0.0.0.0
AGENTFLOW_PORT=8000
AGENTFLOW_WORKER_HEARTBEAT_INTERVAL=15
AGENTFLOW_WORKER_HEARTBEAT_TIMEOUT=45
AGENTFLOW_WORKER_LEASE_DURATION=60
AGENTFLOW_WORKER_RECOVERY_GRACE=300
AGENTFLOW_WORKER_SWEEP_INTERVAL=5
AGENTFLOW_WORKER_POLL_INTERVAL=2

# ---- Judge（只配置在 serve；不读取个人 bub CLI 配置）----
AGENTFLOW_JUDGE_MODEL=
AGENTFLOW_JUDGE_API_KEY=
# 可选：provider API 地址；模型格式 provider:model，例如 openai:your-model
AGENTFLOW_JUDGE_API_BASE=
AGENTFLOW_JUDGE_TIMEOUT_SECONDS=60

# ---- GitHub App（docs/architecture/github-app.md）----
FLOWTOOL_GITHUB_APP_ID=123456
FLOWTOOL_GITHUB_PRIVATE_KEY_PATH=./flowtool-app.private-key.pem
FLOWTOOL_GITHUB_WEBHOOK_SECRET=change-me
# bot 身份（用于忽略自身事件，见 docs/architecture/review-loop.md §B.1）
FLOWTOOL_BOT_LOGIN=flowtool[bot]

# ---- 触发 ----
FLOWTOOL_TRIGGER_LABEL=flow
# 允许触发的用户，逗号分隔（见 docs/architecture/components.md §4.2）
FLOWTOOL_ALLOWLIST=your-username

# ---- PostgreSQL（compose.yaml 的本地开发凭据；远程部署必须使用 TLS 和独立密码）----
FLOWTOOL_DATABASE_URL=postgresql://flowtool:flowtool@127.0.0.1:5432/flowtool

# ---- 本地路径 ----
FLOWTOOL_REPOS_ROOT=~/.flowtool/repos

# ---- 修订循环参数（docs/architecture/review-loop.md §B.7）----
FLOWTOOL_SETTLE_SECONDS=75
FLOWTOOL_SUBMIT_GRACE_SECONDS=15
FLOWTOOL_CONFIDENCE_THRESHOLD=0.6
FLOWTOOL_CODEX_RUN_TIMEOUT_SECONDS=1200
FLOWTOOL_MAX_REVISION_CYCLES=20

# ---- HTTP ----
FLOWTOOL_HOST=0.0.0.0
FLOWTOOL_PORT=8000

# ---- Judge（bub 自读这些环境变量）----
BUB_MODEL=openrouter:openrouter/free
BUB_API_KEY=

# ---- GitHub App（docs/architecture/github-app.md）----
FLOWTOOL_GITHUB_APP_ID=123456
FLOWTOOL_GITHUB_PRIVATE_KEY_PATH=./flowtool-app.private-key.pem
FLOWTOOL_GITHUB_WEBHOOK_SECRET=change-me
# bot 身份（用于忽略自身事件，见 docs/architecture/review-loop.md §B.1）
FLOWTOOL_BOT_LOGIN=flowtool[bot]

# ---- 触发 ----
FLOWTOOL_TRIGGER_LABEL=flow
# 允许触发的用户，逗号分隔（见 docs/architecture/components.md §4.2）
FLOWTOOL_ALLOWLIST=your-username

# ---- PostgreSQL（compose.yaml 的本地开发凭据；远程部署必须使用 TLS 和独立密码）----
FLOWTOOL_DATABASE_URL=postgresql://flowtool:flowtool@127.0.0.1:5432/flowtool

# ---- serve 允许的 worker 身份（JSON；id 与 token 均须唯一且非空）----
FLOWTOOL_WORKER_TOKENS={"worker-1":"change-me-worker-token","worker-2":"change-me-worker-token-2"}

# ---- 当前 worker 实例的身份 ----
FLOWTOOL_WORKER_ID=worker-1
FLOWTOOL_WORKER_TOKEN=change-me-worker-token

# ---- worker 主动连接 serve；生产必须使用 wss:// ----
FLOWTOOL_SERVE_WS_URL=ws://127.0.0.1:8000/internal/workers/connect
# 仅本地开发允许明文 ws://；生产删除此项并配置 wss://。
FLOWTOOL_ALLOW_INSECURE_WORKER_WS=true
# 未设置时默认 ~/.flowtool/workers/<worker-id>；同机实例必须使用不同 root。
# FLOWTOOL_WORKER_ROOT=~/.flowtool/workers/worker-1
FLOWTOOL_RECONNECT_MIN_BACKOFF=1
FLOWTOOL_RECONNECT_MAX_BACKOFF=30
FLOWTOOL_RECONNECT_JITTER=0.2

# ---- 修订循环参数（docs/architecture/review-loop.md §B.7）----
FLOWTOOL_SETTLE_SECONDS=75
FLOWTOOL_SUBMIT_GRACE_SECONDS=15
FLOWTOOL_CONFIDENCE_THRESHOLD=0.6
FLOWTOOL_MAX_REVISION_CYCLES=20

# ---- worker 执行参数 ----
FLOWTOOL_CODEX_RUN_TIMEOUT_SECONDS=1200

# ---- HTTP ----
FLOWTOOL_HOST=0.0.0.0
FLOWTOOL_PORT=8000
FLOWTOOL_WORKER_HEARTBEAT_INTERVAL=15
FLOWTOOL_WORKER_HEARTBEAT_TIMEOUT=45
FLOWTOOL_WORKER_LEASE_DURATION=60
FLOWTOOL_WORKER_RECOVERY_GRACE=300
FLOWTOOL_WORKER_SWEEP_INTERVAL=5
FLOWTOOL_WORKER_POLL_INTERVAL=2

# ---- Judge（bub 自读这些环境变量）----
BUB_MODEL=openrouter:openrouter/free
BUB_API_KEY=

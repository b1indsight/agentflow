FLOWTOOL_DATABASE_URL=postgresql://flowtool:CHANGE_ME@postgres:5432/flowtool
FLOWTOOL_GITHUB_APP_ID=123456
FLOWTOOL_GITHUB_WEBHOOK_SECRET=CHANGE_ME
FLOWTOOL_BOT_LOGIN=your-app[bot]
FLOWTOOL_ALLOWLIST=your-user
FLOWTOOL_REVIEWERS=your-reviewer
FLOWTOOL_WORKER_TOKENS={"worker-1":"CHANGE_ME_WORKER_TOKEN"}
# Optional single-owner Access authentication; all blank disables the user API.
# Configure GitHub login, owner email policy and MFA first; see docs/deployment/access.md.
FLOWTOOL_ACCESS_ISSUER=
FLOWTOOL_ACCESS_AUDIENCE=
FLOWTOOL_ACCESS_OWNER_EMAIL=
FLOWTOOL_JUDGE_MODEL=provider:model
FLOWTOOL_JUDGE_API_KEY=CHANGE_ME

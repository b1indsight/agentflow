AGENTFLOW_DATABASE_URL=postgresql://agentflow:CHANGE_ME@postgres:5432/agentflow
AGENTFLOW_GITHUB_APP_ID=123456
AGENTFLOW_GITHUB_WEBHOOK_SECRET=CHANGE_ME
# Bot login is derived from the authenticated GitHub App; no manual setting is needed.
AGENTFLOW_ALLOWLIST=your-user
AGENTFLOW_REVIEWERS=your-reviewer
AGENTFLOW_WORKER_TOKENS={"worker-1":"CHANGE_ME_WORKER_TOKEN"}
# Optional single-owner Access authentication; all blank disables the user API.
# Configure GitHub login, owner email policy and MFA first; see docs/deployment/access.md.
AGENTFLOW_ACCESS_ISSUER=
AGENTFLOW_ACCESS_AUDIENCE=
AGENTFLOW_ACCESS_OWNER_EMAIL=
AGENTFLOW_JUDGE_MODEL=provider:model
AGENTFLOW_JUDGE_API_KEY=CHANGE_ME

[Unit]
Description=AgentFlow fixed worker (one owner per root)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agentflow-worker
Group=agentflow-worker
WorkingDirectory=/var/lib/agentflow/worker-1/root
EnvironmentFile=/etc/agentflow/worker-1.env
Environment=HOME=/var/lib/agentflow/worker-1/home
Environment=AGENTFLOW_WORKER_ROOT=/var/lib/agentflow/worker-1/root
ExecStart=/opt/agentflow/.venv/bin/agentflow worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentflow/worker-1

[Install]
WantedBy=multi-user.target

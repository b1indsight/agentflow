[Unit]
Description=Flowtool fixed worker (one owner per root)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=flowtool-worker
Group=flowtool-worker
WorkingDirectory=/var/lib/flowtool/worker-1/root
EnvironmentFile=/etc/flowtool/worker-1.env
Environment=HOME=/var/lib/flowtool/worker-1/home
Environment=FLOWTOOL_WORKER_ROOT=/var/lib/flowtool/worker-1/root
ExecStart=/opt/flowtool/.venv/bin/flowtool worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flowtool/worker-1

[Install]
WantedBy=multi-user.target

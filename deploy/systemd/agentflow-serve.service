[Unit]
Description=AgentFlow control plane (single instance)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agentflow-control
Group=agentflow-control
WorkingDirectory=/var/lib/agentflow/control
EnvironmentFile=/etc/agentflow/serve.env
ExecStart=/opt/agentflow/.venv/bin/agentflow serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentflow/control

[Install]
WantedBy=multi-user.target

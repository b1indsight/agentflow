<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentflow.worker</string>
  <key>ProgramArguments</key>
  <array><string>__PYTHON__</string><string>__LAUNCHER__</string><string>--root</string><string>__ROOT__</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ROOT__/worker.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/worker.err</string>
</dict>
</plist>
